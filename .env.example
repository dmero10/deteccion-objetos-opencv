# Copia este archivo como .env y completa tus datos. El .env NO se sube a GitHub.
SECRET_KEY=cambia-esta-clave
DEBUG=1

# PostgreSQL
DB_NAME=deteccion_objetos
DB_USER=postgres
DB_PASSWORD=tu_clave
DB_HOST=localhost
DB_PORT=5432

# Cámara
CAMERA_INDEX=0
CAMERA_ANCHO=640
CAMERA_ALTO=480
CAMERA_ESPEJO=1
CAMERA_CALIDAD_JPEG=80
CAMERA_APAGADO_INACTIVO=15

# Detector de objetos (YOLO11n en ONNX, ejecutado con cv2.dnn)
DETECTOR_ACTIVO=1
DETECTOR_MODELO=yolo11n
DETECTOR_CONFIANZA=0.45
DETECTOR_NMS=0.45

# Bitácora de avistamientos (PostgreSQL)
DETECTOR_REGISTRAR=1
DETECTOR_INTERVALO_REGISTRO=15
ANALIZAR_MAX_MB=8
