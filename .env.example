# Copia este archivo como .env y completa tus datos. El .env NO se sube a GitHub.
SECRET_KEY=cambia-esta-clave
DEBUG=1

# PostgreSQL
DB_NAME=deteccion_objetos
DB_USER=postgres
DB_PASSWORD=tu_clave
DB_HOST=localhost
DB_PORT=5432

# Cámara
CAMERA_INDEX=0
CAMERA_ANCHO=640
CAMERA_ALTO=480
CAMERA_ESPEJO=1
CAMERA_CALIDAD_JPEG=80
CAMERA_APAGADO_INACTIVO=15
